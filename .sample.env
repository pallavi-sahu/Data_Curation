# Copy to .env and fill in values:
#   cp .sample.env .env
#
# .env is gitignored — never commit real API keys.
# The validation CLI loads .env automatically from the project root.

# --- LLM provider selection ---
# Which backend to use for domain, coherence, grammar, sensitivity.
# Options: gemini | openai
# Can also be set via CLI: --llm-provider gemini|openai|gpt
VALIDATION_LLM_PROVIDER=gemini

# --- Google Gemini ---
GEMINI_API_KEY=
# Alternative env name also supported:
# GOOGLE_API_KEY=

# Default Gemini model (used when VALIDATION_LLM_MODEL is not set).
# Must be a full API model ID, e.g. gemini-2.0-flash, gemini-3.5-flash, gemini-3.1-pro-preview
# (NOT "gemini-3" — that shorthand is auto-mapped to gemini-3.5-flash if used)
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI / GPT ---
OPENAI_API_KEY=

# Default OpenAI model (used when VALIDATION_LLM_MODEL is not set)
OPENAI_MODEL=gpt-4o-mini

# --- Shared model override (optional) ---
# If set, overrides GEMINI_MODEL / OPENAI_MODEL for the active provider.
# VALIDATION_LLM_MODEL=gemini-2.0-flash
# VALIDATION_LLM_MODEL=gpt-4o-mini
